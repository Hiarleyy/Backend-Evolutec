generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id                  Int      @id @default(autoincrement())
  slug                String   @unique
  title               String
  category            String
  image               String
  mode                String
  duration            String
  hours               Int
  tag                 String
  description         String
  fullDescription     String   @db.Text
  objectives          String[]
  curriculum          String[]
  careerOpportunities String[]
  requirements        String[]
  certificationType   String
  salary              String
  marketInfo          String   @db.Text
  destaque            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("courses")
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  imagem    String
  tags      String[]
  titulo    String
  subtitulo String
  data      String
  conteudo  String   @db.Text
  destaque  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blog_posts")
}

model Ebook {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  titulo        String
  descricao   String   @db.Text
  categoria   String
  capa        String
  caminho     String?
  downloadUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       LeadEbook[]

  @@map("ebooks")
}

model Lead {
  id               Int        @id @default(autoincrement())
  type             LeadType?
  email            String?
  name             String
  phone            String?
  message          String?    @db.Text
  courseInterest   String?
  city             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  ebookLead        LeadEbook?

  @@map("leads")
}

model LeadEbook {
  id          Int      @id @default(autoincrement())
  leadId      Int      @unique
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ebookId     Int
  ebook       Ebook    @relation(fields: [ebookId], references: [id])
  ebookTitulo String?
  downloadUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("lead_ebooks")
}

model SiteSettings {
  id                 Int      @id @default(autoincrement())
  telefoneWhatsApp   String
  emailContato       String
  linksRedesSociais  Json
  enderecoOuUnidades Json
  mapaLatitude       Float?
  mapaLongitude      Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_settings")
}

enum LeadType {
  CONTACT
  EBOOK
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id         Int     @id @default(autoincrement())
  name       String
  courseName String?
  text       String  @db.Text
  videoId    String?
  imageUrl   String?
  active     Boolean @default(true)
}

model FAQ {
  id       Int    @id @default(autoincrement())
  question String
  answer   String @db.Text
  order    Int    @default(0)
}

model Unit {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  phone       String?
  whatsapp    String?
}

model GalleryImage {
  id       Int     @id @default(autoincrement())
  title    String?
  imageUrl String
  category String?
}

model Stat {
  id    Int     @id @default(autoincrement())
  label String
  value String
  icon  String?
}

// ---------------------------------------------------------
// CAPTURA DE DADOS (FORMULÁRIOS)
// ---------------------------------------------------------

enum ApplicationStatus {
  PENDING
  REVIEWED
  ARCHIVED
}

model JobApplication {
  id        Int               @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String
  role      String
  city      String
  cvFileUrl String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}
